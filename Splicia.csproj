<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Splicia</AssemblyName>
    <Product>Splicia</Product>
    <AssemblyTitle>Splicia</AssemblyTitle>
    <Description>Trim, splice, rotate, crop and export videos</Description>
    <Company>Vesperis Labs</Company>
    <Authors>Vesperis Labs</Authors>
    <Copyright>© 2026 Vesperis Labs. Licensed under CC BY 4.0.</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- One self-contained exe: the .NET runtime is bundled. FFmpeg ships next to it in the ffmpeg\ folder (the setup exe
         carries it as a payload appended by build.ps1), so nothing is extracted to %TEMP% at startup. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <!-- tests\Harness is its own project -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Written out by the installer as the video file-type icon -->
    <EmbeddedResource Include="app.ico" LogicalName="Splicia.app.ico" />
    <!-- Setup wizard artwork -->
    <EmbeddedResource Include="hero.jpg" LogicalName="Splicia.hero.jpg" />
    <!-- License and notices: written next to the exe by the installer, and copied beside the built exe -->
    <EmbeddedResource Include="LICENSE.txt" LogicalName="Splicia.LICENSE.txt" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="Splicia.THIRD-PARTY-NOTICES.txt" />
    <None Include="LICENSE.txt;THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- FFmpeg runtime (DLLs + ffmpeg.exe) next to the built exe, for running from bin\ or publish\ -->
    <None Include="ffmpeg\*.dll;ffmpeg\ffmpeg.exe;ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" Link="ffmpeg\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The Windows Desktop runtime pack ships WPF's native DLLs; this WinForms app never loads them. Leaving them out keeps
       the publish output to a single exe (nothing extracted to %TEMP% at startup). -->
  <Target Name="DropUnusedWpfNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'D3DCompiler_47_cor3' Or '%(Filename)' == 'PenImc_cor3' Or '%(Filename)' == 'PresentationNative_cor3' Or '%(Filename)' == 'vcruntime140_cor3' Or '%(Filename)' == 'wpfgfx_cor3'" />
    </ItemGroup>
  </Target>
</Project>
