<Project>
  <!-- One version for the app, its installer (build.ps1 reads it from here) and the test harness. -->
  <PropertyGroup>
    <Version>1.0.5</Version>
    <!-- Plain "1.0.5" everywhere (exe properties, setup, About, Settings → Apps): no "+<git commit>" suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
