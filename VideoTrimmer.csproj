<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>VideoTrimmer</AssemblyName>
    <Product>Video Trimmer</Product>
    <AssemblyTitle>Video Trimmer</AssemblyTitle>
    <Description>Trim and rotate videos</Description>
    <Version>1.1.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- One self-contained exe: the .NET runtime is bundled. FFmpeg ships next to it in the ffmpeg\ folder (the setup exe
         carries it as a payload appended by build.ps1), so nothing is extracted to %TEMP% at startup. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Written out by the installer as the video file-type icon -->
    <EmbeddedResource Include="app.ico" LogicalName="VideoTrimmer.app.ico" />
    <!-- Setup wizard artwork -->
    <EmbeddedResource Include="hero.jpg" LogicalName="VideoTrimmer.hero.jpg" />
  </ItemGroup>
  <ItemGroup>
    <!-- FFmpeg runtime (DLLs + ffmpeg.exe) next to the built exe, for running from bin\ or publish\ -->
    <None Include="ffmpeg\*.dll;ffmpeg\ffmpeg.exe;ffmpeg\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" Link="ffmpeg\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The Windows Desktop runtime pack ships WPF's native DLLs; this WinForms app never loads them. Leaving them out keeps
       the publish output to a single exe (nothing extracted to %TEMP% at startup). -->
  <Target Name="DropUnusedWpfNatives" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'D3DCompiler_47_cor3' Or '%(Filename)' == 'PenImc_cor3' Or '%(Filename)' == 'PresentationNative_cor3' Or '%(Filename)' == 'vcruntime140_cor3' Or '%(Filename)' == 'wpfgfx_cor3'" />
    </ItemGroup>
  </Target>
</Project>
